---
/** Privacy policy, cookies and accessibility statement – templates with placeholders. */
import { ADDRESS, COMPANY_NAME, EMAIL, ORG_NR, PHONE, hasValue } from '../config/company';
import { ANALYTICS, analyticsEnabled } from '../config/site';
import { fmt, useT } from '../i18n';
import { path, type Alternates, type Locale } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Container from '../components/Container.astro';
import Text from '../components/Text.astro';

interface Props {
  locale: Locale;
  alternates: Alternates;
  doc: 'privacy' | 'cookies' | 'accessibility';
}
const { locale, alternates, doc } = Astro.props;
const t = useT(locale);
const vars = { company: COMPANY_NAME, orgnr: ORG_NR, address: ADDRESS, email: EMAIL, phone: PHONE };
const page = t.legal[doc];
const sections = doc === 'cookies' ? [] : t.legal[doc].sections;
const cookies = t.legal.cookies;
const crumbs = [
  { label: t.nav.home, href: path('home', locale) },
  { label: page.title, href: alternates[locale] },
];
---

<BaseLayout locale={locale} title={page.meta.title} description={page.meta.description} alternates={alternates}>
  <Container size="narrow" class="py-12 md:py-16">
    <Breadcrumbs items={crumbs} label={t.a11y.breadcrumb} />
    <h1 class="text-[2rem]">{page.title}</h1>
    {hasValue(page.date) && <p class="mt-3 text-sm text-ink-muted">{t.legal.updated}: {page.date}</p>}

    <div class="prose-site mt-8">
      <p class="font-bold"><Text text={fmt(page.intro, vars)} /></p>

      {
        sections.map((s) => (
          <section>
            <h2>{s.h}</h2>
            {s.p.map((para) => (
              <p>
                <Text text={fmt(para, vars)} />
              </p>
            ))}
            {s.list.length > 0 && (
              <ul>
                {s.list.map((li) => (
                  <li>
                    <Text text={fmt(li, vars)} />
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }

      {
        doc === 'cookies' && (
          <>
            <p>{analyticsEnabled ? fmt(cookies.analyticsOn, { provider: ANALYTICS.provider }) : cookies.none}</p>
            <p>{cookies.session}</p>
            {analyticsEnabled && (
              <p>
                <button type="button" data-consent-reset class="inline-flex min-h-[2.6875rem] items-center justify-center rounded-full border-2 border-line-strong bg-surface px-6 font-bold text-ink transition-colors duration-200 ease-out hover:border-ink">
                  {cookies.change}
                </button>
              </p>
            )}
            <p>{cookies.manage}</p>
          </>
        )
      }

      {doc === 'privacy' && <p><a href={path('cookies', locale)}>{t.footer.cookies}</a></p>}
    </div>
  </Container>
</BaseLayout>
