---
/**
 * Contact + quote request. Layout pattern: Upwork stepper with side panel;
 * contact blocks after Monte (contact / hours / find us) and Homerun (address + "Google Maps" button).
 */
import { ADDRESS, EMAIL, HAS_PHONE, MAP_IMAGE, MAP_URL, OPENING_HOURS, PHONE, SERVICE_AREA, TEAM, hasValue, telHref } from '../config/company';
import { breadcrumbSchema } from '../data/schema';
import { fmt, useT } from '../i18n';
import { path, type Alternates, type Locale } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Container from '../components/Container.astro';
import Icon from '../components/Icon.astro';
import MultiStepForm from '../components/MultiStepForm.astro';
import Photo from '../components/Photo.astro';
import Text from '../components/Text.astro';

interface Props {
  locale: Locale;
  alternates: Alternates;
}
const { locale, alternates } = Astro.props;
const t = useT(locale);
const c = t.contact;
const site = Astro.site!;
const crumbs = [
  { label: t.nav.home, href: path('home', locale) },
  { label: t.nav.contact, href: path('contact', locale) },
];
const contactPerson = TEAM[0];
---

<BaseLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternates}
  jsonLd={[breadcrumbSchema(crumbs.map((x) => ({ label: x.label, url: new URL(x.href, site).href })))]}
>
  <section class="bg-paper">
    <Container class="pt-8 pb-4">
      <Breadcrumbs items={crumbs} label={t.a11y.breadcrumb} />
      <p class="eyebrow mb-2">{c.hero.eyebrow}</p>
      <h1 class="text-[2rem]">{c.hero.title}</h1>
      <p class="mt-3 max-w-2xl">{c.hero.lead}</p>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1">
        {c.preferCall}
        {
          HAS_PHONE ? (
            <a href={telHref(PHONE)} class="inline-flex items-center gap-2 font-bold text-accent-strong hover:underline">
              <Icon name="phone" class="h-5 w-5 text-accent-strong" />
              {PHONE}
            </a>
          ) : (
            <a href={`mailto:${EMAIL}`} class="inline-flex items-center gap-2 font-bold text-accent-strong hover:underline">
              <Icon name="mail" class="h-5 w-5 text-accent-strong" />
              {EMAIL}
            </a>
          )
        }
      </p>
    </Container>
  </section>

  <Container class="grid gap-8 py-8 lg:grid-cols-12">
    <div id="offert" class="scroll-mt-28 lg:col-span-8">
      <MultiStepForm locale={locale} />
    </div>

    <aside class="space-y-6 lg:col-span-4" aria-labelledby="details-title">
      <h2 id="details-title" class="text-[1.625rem] font-bold">{c.details.title}</h2>
      <ul class="divide-y divide-line border-y border-line">
        {
          HAS_PHONE && (
            <li class="py-4">
              <p class="eyebrow">{t.common.phone}</p>
              <a href={telHref(PHONE)} class="mt-1 block text-[1.625rem] font-bold hover:underline">
                {PHONE}
              </a>
            </li>
          )
        }
        <li class="py-4">
          <p class="eyebrow">{t.common.email}</p>
          <a href={`mailto:${EMAIL}`} class="mt-1 block font-semibold break-all hover:underline"><Text text={EMAIL} /></a>
        </li>
        {
          hasValue(OPENING_HOURS[locale]) && (
            <li class="py-4">
              <p class="eyebrow">{t.common.openingHours}</p>
              <p class="mt-1">{OPENING_HOURS[locale]}</p>
            </li>
          )
        }
        <li class="py-4">
          <p class="eyebrow">{t.common.serviceArea}</p>
          <p class="mt-1"><Text text={SERVICE_AREA[locale]} /></p>
        </li>
        {
          contactPerson && (
            <li class="py-4">
              <p class="eyebrow">{t.about.team.title}</p>
              <p class="mt-1 font-semibold">
                <Text text={contactPerson.name} />
              </p>
              <p class="text-sm text-ink-muted">
                <Text text={contactPerson.role[locale]} />
              </p>
            </li>
          )
        }
      </ul>

      <div class="bg-inverse p-6 text-on-inverse">
        <p class="eyebrow text-on-inverse-muted">{t.common.address}</p>
        <address class="mt-2 text-[1.625rem] leading-[1.2] font-bold not-italic"><Text text={ADDRESS} /></address>
        {
          hasValue(MAP_IMAGE) && (
            <a href={MAP_URL} target="_blank" rel="noopener" class="mt-4 block border border-white/20 hover:border-accent">
              <Photo src={MAP_IMAGE} alt={fmt(c.details.mapAlt, { address: ADDRESS })} width={800} height={533} sizes="(min-width: 1024px) 30vw, 100vw" figureClass="aspect-[3/2]" />
            </a>
          )
        }
        <a href={MAP_URL} target="_blank" rel="noopener" class="mt-4 inline-flex min-h-[2.6875rem] items-center justify-center rounded-full border-2 border-white px-6 font-bold text-white transition-colors duration-200 ease-out hover:bg-white hover:text-ink">
          {c.details.mapLink}<Icon name="external" class="h-4 w-4" /><span class="sr-only">{t.a11y.newTab}</span>
        </a>
        {hasValue(MAP_IMAGE) && <p class="mt-3 text-xs text-on-inverse-muted">{c.details.mapNote}</p>}
      </div>
    </aside>
  </Container>
</BaseLayout>
