---
import { published } from '../data/collections';
import { breadcrumbSchema } from '../data/schema';
import { useT } from '../i18n';
import { detailPath, path, type Alternates, type Locale } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import ApplicationForm from '../components/ApplicationForm.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Text from '../components/Text.astro';

interface Props {
  locale: Locale;
  alternates: Alternates;
}
const { locale, alternates } = Astro.props;
const t = useT(locale);
const c = t.careers;
const site = Astro.site!;
const jobs = (await published('jobs', (e) => e.id.startsWith(`${locale}/`))).sort((a, b) => a.data.title.localeCompare(b.data.title));
const slug = (id: string) => id.split('/').slice(1).join('/');
const crumbs = [
  { label: t.nav.home, href: path('home', locale) },
  { label: t.nav.careers, href: path('careers', locale) },
];
---

<BaseLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternates}
  jsonLd={[breadcrumbSchema(crumbs.map((x) => ({ label: x.label, url: new URL(x.href, site).href })))]}
>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} image="placeholders/careers.jpg" breadcrumbs={crumbs} breadcrumbLabel={t.a11y.breadcrumb} />

  <Section labelledby="why-title">
    <SectionHeader id="why-title" title={c.why.title} />
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        c.why.items.map((w, i) => (
          <li class="border-t-[3px] border-accent pt-5">
            <span class="text-sm text-ink-muted">0{i + 1}</span>
            <h3 class="mt-2 text-[1.625rem] font-bold">{w.title}</h3>
            <p class="mt-2 text-ink-muted">
              <Text text={w.text} />
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Open positions (pattern: Tines / Runway role rows) -->
  <Section tone="concrete" labelledby="positions-title">
    <h2 id="positions-title" class="text-[1.625rem]">{c.positions.title}</h2>
    {
      jobs.length === 0 ? (
        <p class="mt-8 border border-dashed border-line p-8">{c.positions.empty}</p>
      ) : (
        <ul class="mt-8 divide-y divide-line border-y border-line">
          {jobs.map((job) => (
            <li class="group relative grid gap-2 py-6 md:grid-cols-[1fr_12rem_12rem_auto] md:items-center md:gap-6">
              <div>
                <h3 class="text-[1.625rem] font-bold">
                  <a href={detailPath('careers', slug(job.id), locale)} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-accent group-hover:decoration-4">
                    <Text text={job.data.title} />
                  </a>
                </h3>
                <p class="mt-1 text-ink-muted">
                  <Text text={job.data.summary} />
                </p>
              </div>
              <p class="text-sm">
                <span class="block text-ink-muted">{c.positions.location}</span>
                <Text text={job.data.location} />
              </p>
              <p class="text-sm">
                <span class="block text-ink-muted">{c.positions.type}</span>
                <Text text={job.data.employment} />
              </p>
              <span class="grid h-12 w-12 place-items-center bg-accent text-on-accent" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  <Section labelledby="apprentices-title">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 id="apprentices-title" class="text-[1.625rem]">{c.apprentices.title}</h2>
        <p class="mt-3"><Text text={c.apprentices.text} /></p>
      </div>
      <div class="bg-inverse p-6 text-on-inverse md:p-8">
        <h2 class="text-[1.625rem] font-bold">{c.cards.title}</h2>
        <p class="mt-2 text-on-inverse-muted">{c.cards.lead}</p>
        <ul class="mt-5 space-y-3">
          {
            c.cards.items.map((item) => (
              <li class="flex gap-3">
                <span class="grid h-6 w-6 shrink-0 place-items-center bg-accent text-on-accent" aria-hidden="true">
                  <Icon name="check" class="h-4 w-4" />
                </span>
                <span>
                  <Text text={item} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section id="ansok" tone="concrete" labelledby="apply-title" size="narrow">
    <h2 id="apply-title" class="text-[1.625rem]">{c.form.title}</h2>
    <p class="mt-3 mb-8 font-bold">{c.form.lead}</p>
    <ApplicationForm locale={locale} positions={jobs.map((j) => j.data.title)} />
  </Section>
</BaseLayout>
