---
import { COMPANY_NAME, EQUIPMENT, FOUNDED_YEAR, TEAM, hasValue } from '../config/company';
import { breadcrumbSchema } from '../data/schema';
import { fmt, useT } from '../i18n';
import { path, type Alternates, type Locale } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTABand from '../components/CTABand.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TeamCard from '../components/TeamCard.astro';
import Text from '../components/Text.astro';

interface Props {
  locale: Locale;
  alternates: Alternates;
}
const { locale, alternates } = Astro.props;
const t = useT(locale);
const a = t.about;
const site = Astro.site!;
const crumbs = [
  { label: t.nav.home, href: path('home', locale) },
  { label: t.nav.about, href: path('about', locale) },
];
---

<BaseLayout
  locale={locale}
  title={a.meta.title}
  description={a.meta.description}
  alternates={alternates}
  jsonLd={[breadcrumbSchema(crumbs.map((c) => ({ label: c.label, url: new URL(c.href, site).href })))]}
>
  <PageHero eyebrow={a.hero.eyebrow} title={a.hero.title} lead={a.hero.lead} image="placeholders/about.jpg" breadcrumbs={crumbs} breadcrumbLabel={t.a11y.breadcrumb} />

  <Section labelledby="story-title">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="story-title" class="text-[1.625rem]">{a.story.title}</h2>
        {
          hasValue(FOUNDED_YEAR) && (
            <p class="mt-6 text-[2rem] leading-[1.2] font-bold text-accent-strong" aria-hidden="true">
              {FOUNDED_YEAR}
            </p>
          )
        }
      </div>
      <div class="prose-site lg:col-span-8">
        {
          a.story.paragraphs.map((p, i) => (
            <p class:list={[i === 0 && 'text-[1.375rem] font-semibold']}>
              <Text text={fmt(p, { company: COMPANY_NAME, year: FOUNDED_YEAR })} />
            </p>
          ))
        }
      </div>
    </div>
  </Section>

  <Section tone="inverse" labelledby="values-title">
    <SectionHeader id="values-title" title={a.values.title} inverse />
    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {
        a.values.items.map((v, i) => (
          <li class="border-t-[3px] border-accent pt-6">
            <span class="text-sm text-on-inverse-muted">0{i + 1}</span>
            <h3 class="mt-2 text-[2rem] font-bold">{v.title}</h3>
            <p class="mt-3 text-on-inverse-muted">{v.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    TEAM.length > 0 && (
      <Section labelledby="team-title">
        <SectionHeader id="team-title" title={a.team.title} lead={a.team.lead} />
        <ul class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {TEAM.map((m) => (
            <TeamCard name={m.name} role={m.role[locale]} phone={m.phone} email={m.email} photo={m.photo} labels={a.team} />
          ))}
        </ul>
      </Section>
    )
  }

  {EQUIPMENT.length > 0 && (
  <Section tone="concrete" labelledby="equipment-title">
    <SectionHeader id="equipment-title" title={a.equipment.title} lead={a.equipment.lead} />
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        EQUIPMENT.map((m) => (
          <li class="bg-surface">
            <Photo src={m.image} alt="" width={600} height={450} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" figureClass="aspect-[4/3]" />
            <div class="p-5">
              <h3 class="text-lg font-bold">
                <Text text={m.name[locale]} />
              </h3>
              <p class="mt-1 text-sm text-ink-muted">
                <Text text={m.spec[locale]} />
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>
  )}

  <Section labelledby="join-title" spacing="tight">
    <div class="flex flex-col gap-6 border-t-[3px] border-accent-strong bg-surface p-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 id="join-title" class="text-[1.625rem]">{a.careersCta.title}</h2>
        <p class="mt-2 text-ink-muted">{a.careersCta.text}</p>
      </div>
      <Button href={path('careers', locale)} variant="secondary" icon="arrow">{a.careersCta.cta}</Button>
    </div>
  </Section>

  <CTABand locale={locale} />
</BaseLayout>
