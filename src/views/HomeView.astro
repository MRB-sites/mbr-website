---
import { published } from '../data/collections';
import { Image } from 'astro:assets';
import brandLogo from '../assets/brand/mbr-logo.png';
import { COMPANY_NAME, DIRECT_CONTACT, HAS_PHONE, KEY_FIGURES, PROMISES, SERVICE_AREA } from '../config/company';
import { SERVICES, SERVICE_IDS } from '../data/services';
import { fmt, useT } from '../i18n';
import { detailPath, path, quotePath, type Alternates, type Locale } from '../i18n/routes';
import AdviceButton from '../components/AdviceButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import Button from '../components/Button.astro';
import CTABand from '../components/CTABand.astro';
import Container from '../components/Container.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import PhotoBanner from '../components/PhotoBanner.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PromiseBadge from '../components/PromiseBadge.astro';
import RoutingTile from '../components/RoutingTile.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatFigure from '../components/StatFigure.astro';
import Text from '../components/Text.astro';

interface Props {
  locale: Locale;
  alternates: Alternates;
}
const { locale, alternates } = Astro.props;
const t = useT(locale);
const h = t.home;

const projects = (await published('projects')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year);
const showcase = projects.find((p) => p.data.beforeImage && p.data.afterImage);
const cardProjects = projects.filter((p) => p !== showcase).slice(0, 2);

const routingTargets = [path('service.rivning', locale), path('service.sanering', locale), path('service.nybyggnation', locale), `${path('services', locale)}#entreprenorer`];
const logoClass = 'h-[min(55vh,30.25rem)] w-auto max-w-[80vw] object-contain';
---

<BaseLayout locale={locale} title={h.meta.title} description={h.meta.description} alternates={alternates} isHome intro>
  <!--
    Intro: logo only, three stacked layers – sharp logo, a blurred copy above it, and a white veil on top.
    The veil fades first, then the blurred copy fades so the logo pulls into focus.
    Header and mobile bar appear once the visitor scrolls (see BaseLayout).
  -->
  <section class="intro relative grid min-h-dvh place-items-center overflow-hidden bg-white" aria-label={COMPANY_NAME}>
    <div class="relative">
      <Image src={brandLogo} alt={COMPANY_NAME} class:list={[logoClass, 'intro-sharp']} loading="eager" fetchpriority="high" />
      <Image src={brandLogo} alt="" aria-hidden="true" class:list={[logoClass, 'intro-blur absolute inset-0']} loading="eager" />
    </div>
    <div class="intro-veil pointer-events-none absolute inset-0 bg-white" aria-hidden="true"></div>
    <a href="#intro-title" class="intro-cue absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1 text-sm text-ink-muted hover:text-ink">
      {h.hero.scroll}
      <Icon name="chevron" class="h-6 w-6 text-highlight" />
    </a>
  </section>

  <div class="space-y-12 pt-12 pb-6">
    <!-- Intro block: H1 on the grey canvas -->
    <Container>
      <h1 id="intro-title" class="max-w-3xl text-[2rem]">{h.hero.title}</h1>
      <p class="mt-3 max-w-2xl"><Text text={fmt(h.hero.lead, { area: SERVICE_AREA[locale] })} /></p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={quotePath(locale)}>{t.cta.quote}</Button>
        {HAS_PHONE ? <Button href={DIRECT_CONTACT.href} variant="secondary">{t.cta.call}</Button> : <AdviceButton locale={locale} />}
      </div>
    </Container>

    <!-- Services -->
    <Container>
      <section aria-labelledby="services-title">
        <h2 id="services-title" class="rule-heading text-[1.625rem]">{h.services.title}</h2>
        <p class="mt-6 max-w-2xl font-bold">{h.services.lead}</p>
        <ul class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            SERVICE_IDS.map((id) => {
              const s = t.services.items[id];
              return (
                <li>
                  <ServiceCard href={path(SERVICES[id].route, locale)} title={s.name} text={s.short} image={SERVICES[id].image} items={s.offerings.slice(0, 3).map((o) => o.title)} />
                </li>
              );
            })
          }
        </ul>
        <div class="mt-6 flex justify-end">
          <Button href={path('services', locale)}>{t.cta.allServices}</Button>
        </div>
      </section>
    </Container>

    <!-- Visitor routing: numbered question rows -->
    <Container>
      <section aria-labelledby="routing-title">
        <h2 id="routing-title" class="rule-heading text-[1.625rem]">{h.routing.title}</h2>
        <ul class="mt-2">
          {
            h.routing.tiles.map((tile, i) => (
              <li>
                <RoutingTile href={routingTargets[i]} title={tile.title} text={tile.text} />
              </li>
            ))
          }
        </ul>
      </section>
    </Container>

    <!-- The whole chain -->
    <Container>
      <section class="grid gap-8 bg-surface p-6 md:grid-cols-[2fr_3fr] md:p-8" aria-labelledby="chain-title">
        <!-- Left column fills the timeline's height: intro, contact portrait, then the two CTAs -->
        <div class="flex flex-col">
          <h2 id="chain-title" class="text-[1.625rem]">{h.chain.title}</h2>
          <p class="mt-3">{h.chain.lead}</p>
          <Photo
            src="placeholders/safety.jpg"
            alt=""
            width={640}
            height={800}
            sizes="(min-width: 768px) 360px, 100vw"
            figureClass="mt-6 hidden min-h-64 flex-1 md:block"
          />
          <div class="mt-6 flex flex-wrap gap-3">
            <Button href={quotePath(locale)}>{t.cta.quote}</Button>
            {HAS_PHONE ? <Button href={DIRECT_CONTACT.href} variant="secondary">{t.cta.call}</Button> : <AdviceButton locale={locale} />}
          </div>
        </div>
        <ProcessTimeline steps={h.chain.steps} variant="vertical" />
      </section>
    </Container>

    <!-- Environment: split media module, image left -->
    <Container>
      <section class="grid bg-surface md:grid-cols-2" aria-labelledby="env-title">
        <Photo src="placeholders/environment.jpg" alt="" width={960} height={720} sizes="(min-width: 768px) 480px, 100vw" figureClass="aspect-[4/3] md:aspect-auto md:h-full" />
        <div class="p-6">
          <h2 id="env-title" class="text-[1.375rem] text-accent-strong">
            <a href={path('environment', locale)} class="hover:underline">{h.environment.title}</a>
          </h2>
          <p class="mt-2">{h.environment.lead}</p>
          <ul class="mt-4 divide-y divide-line">
            {
              h.environment.points.map((p) => (
                <li class="py-3">
                  <h3 class="flex items-center gap-2 text-base font-bold">
                    <span class="caret" aria-hidden="true" />
                    {p.title}
                  </h3>
                  <p class="mt-1 text-sm">{p.text}</p>
                </li>
              ))
            }
          </ul>
          <Button href={path('environment', locale)} class="mt-4">{h.environment.cta}</Button>
        </div>
      </section>
    </Container>

    <!-- Promises -->
    <Container>
      <section aria-labelledby="promises-title">
        <h2 id="promises-title" class="rule-heading text-[1.625rem]">{h.promises.title}</h2>
        <ul class="mt-6 grid gap-8 sm:grid-cols-2">
          {PROMISES.map((p) => <PromiseBadge title={p.title[locale]} text={p.text[locale]} />)}
        </ul>
      </section>
    </Container>

    <!-- The single green strip: verified key figures when set in company.ts, otherwise who we work for -->
    <Container>
      {
        KEY_FIGURES.length > 0 ? (
          <section class="bg-inverse px-6 py-8 text-on-inverse" aria-labelledby="figures-title">
            <h2 id="figures-title" class="text-[1.375rem]">
              {h.figures.title}
            </h2>
            <dl class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
              {KEY_FIGURES.map((k) => (
                <StatFigure value={k.value} unit={k.unit[locale]} label={k.label[locale]} />
              ))}
            </dl>
          </section>
        ) : (
          <section class="bg-inverse px-6 py-8 text-on-inverse" aria-labelledby="customers-title">
            <h2 id="customers-title" class="text-[1.375rem]">
              {h.customers.title}
            </h2>
            <ul class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
              {h.customers.items.map((c) => (
                <li class="border-l-[3px] border-accent pl-4">
                  <h3 class="text-base font-bold">{c.title}</h3>
                  <p class="mt-1 text-sm text-on-inverse-muted">{c.text}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </Container>

    <!-- Projects -->
    {
      projects.length > 0 && (
        <Container>
          <section aria-labelledby="projects-title">
            <h2 id="projects-title" class="rule-heading text-[1.625rem]">{h.projects.title}</h2>
            {showcase && (
              <div class="mt-6 bg-surface">
                <BeforeAfterSlider
                  before={showcase.data.beforeImage!}
                  after={showcase.data.afterImage!}
                  beforeAlt={fmt(t.projects.beforeAfter.beforeAlt, { title: showcase.data.title[locale] })}
                  afterAlt={fmt(t.projects.beforeAfter.afterAlt, { title: showcase.data.title[locale] })}
                  labels={t.projects.beforeAfter}
                 
                />
                <div class="p-6">
                  <h3 class="text-[1.375rem] text-accent-strong">
                    <a href={detailPath('projects', showcase.id, locale)} class="hover:underline">
                      <Text text={showcase.data.title[locale]} />
                    </a>
                  </h3>
                  <p class="mt-2 text-sm">{h.projects.lead}</p>
                </div>
              </div>
            )}
            <ul class="mt-8 grid gap-8 sm:grid-cols-2">
              {(showcase ? cardProjects : projects.slice(0, 2)).map((p) => (
                <li>
                  <ProjectCard
                    href={detailPath('projects', p.id, locale)}
                    title={p.data.title[locale]}
                    location={p.data.location}
                    year={p.data.year}
                    category={p.data.category}
                    categoryLabel={t.projects.categories[p.data.category]}
                    image={p.data.cover}
                    example={p.data.example}
                    exampleLabel={t.common.example}
                  />
                </li>
              ))}
            </ul>
            <div class="mt-6 flex justify-end">
              <Button href={path('projects', locale)}>{t.cta.allProjects}</Button>
            </div>
          </section>
        </Container>
      )
    }

    <!-- Careers: full-width photo banner -->
    <Container>
      <PhotoBanner href={path('careers', locale)} image="placeholders/careers.jpg" title={h.careers.title} text={h.careers.text} cta={h.careers.cta} />
    </Container>
  </div>

  <CTABand locale={locale} />
</BaseLayout>

<style>
  .intro-veil {
    animation: veil-out 1.4s ease-out 0.2s both;
  }
  .intro-blur {
    filter: blur(18px);
    transform: scale(1.04);
    animation: focus-in 1.1s ease-out 1.2s both;
  }
  .intro-sharp {
    animation: fade-in 1.1s ease-out 1.2s both;
  }
  .intro-cue {
    animation: fade-in 0.6s ease-out 2.4s both;
  }
  @keyframes veil-out {
    to {
      opacity: 0;
    }
  }
  @keyframes focus-in {
    to {
      opacity: 0;
      filter: blur(0);
      transform: scale(1);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>
