---
import { type CollectionEntry } from 'astro:content';
import { published } from '../data/collections';
import { breadcrumbSchema } from '../data/schema';
import { fmt, useT } from '../i18n';
import { detailPath, path, type Alternates, type Locale } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import CTABand from '../components/CTABand.astro';
import Container from '../components/Container.astro';
import FactsBox from '../components/FactsBox.astro';
import Gallery from '../components/Gallery.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Section from '../components/Section.astro';
import Text from '../components/Text.astro';

interface Props {
  locale: Locale;
  alternates: Alternates;
  entry: CollectionEntry<'projects'>;
}
const { locale, alternates, entry } = Astro.props;
const t = useT(locale);
const p = t.projects;
const d = entry.data;
const site = Astro.site!;
const title = d.title[locale];

const related = (await published('projects', (e) => e.id !== entry.id))
  .sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category) || b.data.year - a.data.year)
  .slice(0, 3);

const crumbs = [
  { label: t.nav.home, href: path('home', locale) },
  { label: t.nav.projects, href: path('projects', locale) },
  { label: title.replace(/^\[[^\]]*\]\s*/, ''), href: detailPath('projects', entry.id, locale) },
];
const facts = [
  { label: p.facts.category, value: p.categories[d.category] },
  { label: p.facts.location, value: d.location },
  { label: p.facts.client, value: d.client },
  { label: p.facts.contractType, value: d.contractType[locale] },
  { label: p.facts.year, value: String(d.year) },
  { label: p.facts.scope, value: d.scope[locale] },
  { label: p.facts.recycled, value: d.recycledPercent ? `${d.recycledPercent} %` : undefined },
];
---

<BaseLayout
  locale={locale}
  title={`${title} – ${d.location}`}
  description={d.summary[locale]}
  alternates={alternates}
  ogImage={d.cover}
  ogImageAlt={title}
  ogType="article"
  jsonLd={[breadcrumbSchema(crumbs.map((c) => ({ label: c.label, url: new URL(c.href, site).href })))]}
>
  <!-- Photo banner (448px) with bottom gradient and inset title -->
  <div class="bg-paper pt-8 pb-6">
    <Container>
      <Breadcrumbs items={crumbs} label={t.a11y.breadcrumb} />
      <section class="relative isolate flex h-[28rem] items-end overflow-hidden text-white" aria-labelledby="project-title">
        <div class="absolute inset-0 -z-10">
          <Photo src={d.cover} alt="" width={960} height={448} sizes="(min-width: 1000px) 960px, 100vw" priority figureClass="h-full" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 to-black/0" aria-hidden="true"></div>
        </div>
        <div class="p-6 md:px-28 md:pb-10">
          <p class="mb-2 text-sm font-semibold text-white/80">{p.categories[d.category]}</p>
          <h1 id="project-title" class="max-w-3xl text-[2.25rem]"><Text text={title} /></h1>
          <p class="mt-2"><Text text={d.location} /> · {d.year}</p>
        </div>      </section>
      {
        d.example && (
          <p class="flex items-center gap-3 border-b border-line bg-surface px-6 py-3 text-sm font-semibold">
            <Icon name="alert" class="h-5 w-5 text-highlight" />
            {t.common.exampleProject}
          </p>
        )
      }
    </Container>
  </div>

  <Section labelledby="about-project">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 id="about-project" class="text-[1.625rem]">{p.description}</h2>
        <p class="mt-6 font-bold"><Text text={d.summary[locale]} /></p>
        <p class="mt-4"><Text text={d.description[locale]} /></p>
      </div>
      <div class="lg:col-span-5">
        <FactsBox title={p.facts.title} facts={facts} />
      </div>
    </div>
  </Section>

  {
    d.beforeImage && d.afterImage && (
      <Section tone="concrete" labelledby="ba-title">
        <h2 id="ba-title" class="mb-8 text-[1.625rem]">
          {p.beforeAfter.title}
        </h2>
        <div class="max-w-5xl">
          <BeforeAfterSlider
            before={d.beforeImage}
            after={d.afterImage}
            beforeAlt={fmt(p.beforeAfter.beforeAlt, { title })}
            afterAlt={fmt(p.beforeAfter.afterAlt, { title })}
            labels={p.beforeAfter}
           
          />
        </div>
      </Section>
    )
  }

  {
    d.images.length > 0 && (
      <Section labelledby="gallery-title">
        <h2 id="gallery-title" class="mb-8 text-[1.625rem]">
          {p.gallery.title}
        </h2>
        <Gallery images={d.images} alt={title} openLabel={p.gallery.open} />
      </Section>
    )
  }

  {
    related.length > 0 && (
      <Section tone="concrete" labelledby="related-title">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="related-title" class="text-[1.625rem]">
            {p.related}
          </h2>
          <Button href={path('projects', locale)} variant="secondary" icon="arrow-left" iconPosition="start">
            {p.back}
          </Button>
        </div>
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((e) => (
            <li>
              <ProjectCard
                href={detailPath('projects', e.id, locale)}
                title={e.data.title[locale]}
                location={e.data.location}
                year={e.data.year}
                category={e.data.category}
                categoryLabel={p.categories[e.data.category]}
                image={e.data.cover}
                example={e.data.example}
                exampleLabel={t.common.example}
              />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <CTABand locale={locale} />
</BaseLayout>
