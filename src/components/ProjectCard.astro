---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Text from './Text.astro';

interface Props {
  href: string;
  title: string;
  location: string;
  year: number;
  category: string;
  categoryLabel: string;
  image: ImageMetadata;
  example?: boolean;
  exampleLabel?: string;
  headingLevel?: 'h2' | 'h3';
}
const { href, title, location, year, category, categoryLabel, image, example, exampleLabel, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="group relative flex flex-col bg-surface" data-project-card data-category={category} data-year={year}>
  <div class="relative">
    <Photo src={image} alt="" width={800} height={600} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" figureClass="aspect-[4/3]" />
    <span class="absolute top-4 left-4 bg-surface px-2 py-0.5 text-sm font-semibold">{categoryLabel}</span>
    {example && <span class="absolute top-4 right-4 bg-black/30 px-1.5 py-0.5 text-xs text-white">{exampleLabel}</span>}
  </div>
  <div class="p-6">
    <div>
      <Heading class="text-[1.375rem] leading-[1.2] font-bold text-accent-strong">
        <a href={href} class="after:absolute after:inset-0 group-hover:underline">
          <Text text={title} />
        </a>
      </Heading>
      <p class="mt-2 text-sm"><Text text={location} /> · {year}</p>
    </div>
  </div>
</article>
