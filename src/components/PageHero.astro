---
/** Inner-page hero: breadcrumb, H1 intro on the grey canvas and optional photo. */
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Container from './Container.astro';
import Photo from './Photo.astro';
import Text from './Text.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  breadcrumbs: { label: string; href?: string }[];
  breadcrumbLabel: string;
}
const { eyebrow, title, lead, image, imageAlt = '', breadcrumbs, breadcrumbLabel } = Astro.props;
---

<section class="bg-paper">
  <Container class:list={['grid gap-8 pt-8 pb-4', image && 'lg:grid-cols-2 lg:items-center lg:gap-0']}>
    <div class:list={[image && 'lg:bg-surface lg:p-6 lg:self-stretch lg:flex lg:flex-col lg:justify-center']}>
      <Breadcrumbs items={breadcrumbs} label={breadcrumbLabel} />
      {
        eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>
      }
      <h1 class="text-[2rem]"><Text text={title} /></h1>
      {lead && <p class="mt-3 max-w-2xl"><Text text={lead} /></p>}
      <slot />
    </div>
    {
      image && (
        <div class="lg:order-first">
          <Photo src={image} alt={imageAlt} width={960} height={720} sizes="(min-width: 1024px) 480px, 100vw" priority figureClass="aspect-[4/3]" />
        </div>
      )
    }
  </Container>
</section>
