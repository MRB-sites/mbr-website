---
/**
 * Visitor routing row: question title, short text and an arrow, one full-width row per question.
 * Kept as an open list on the grey canvas so it reads differently from the photo service cards below.
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  text: string;
}
const { href, title, text } = Astro.props;
---

<a
  href={href}
  class="group relative grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 border-b border-line-strong py-5 pr-2 pl-3 transition-colors duration-200 hover:bg-surface md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)_auto] md:gap-x-8 md:py-6 md:pl-4"
>
  <span class="absolute inset-y-0 left-0 w-1 origin-top scale-y-0 bg-highlight transition-transform duration-200 group-hover:scale-y-100" aria-hidden="true"></span>
  <span class="text-[1.25rem] leading-[1.25] font-bold text-accent-strong group-hover:underline md:text-[1.375rem]">{title}</span>
  <span class="col-start-1 text-sm md:col-start-auto md:text-base">{text}</span>
  <span
    class="col-start-2 row-span-2 row-start-1 grid h-10 w-10 place-items-center rounded-full border border-line-strong text-accent transition-colors duration-200 group-hover:border-accent group-hover:bg-accent group-hover:text-on-accent md:col-start-auto md:row-span-1 md:row-start-auto"
    aria-hidden="true"
  >
    <Icon name="arrow" class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-0.5" />
  </span>
</a>
