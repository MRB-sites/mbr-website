---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getAsset } from '../data/images';

interface Props {
  /** ImageMetadata or a path below src/assets/, e.g. 'placeholders/hero.jpg' */
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  layout?: 'constrained' | 'full-width' | 'fixed';
  priority?: boolean;
  /** classes on the <img> */
  class?: string;
  /** classes on the <figure> wrapper */
  figureClass?: string;
  position?: string;
}

const {
  src,
  alt,
  width,
  height,
  sizes,
  layout = 'constrained',
  priority = false,
  class: className,
  figureClass,
  position,
} = Astro.props;
const image = typeof src === 'string' ? getAsset(src) : src;
---

<figure class:list={['relative overflow-hidden', figureClass]}>
  <Picture
    src={image}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    layout={layout}
    fit="cover"
    position={position}
    formats={['avif', 'webp']}
    priority={priority}
    class:list={['h-full w-full object-cover', className]}
    pictureAttributes={{ class: 'block h-full w-full' }}
  />
</figure>
