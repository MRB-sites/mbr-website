  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  recycle:
    '<path d="M7 19H4.8a1.8 1.8 0 0 1-1.6-2.7L7 9.8M11 19h8.2a1.8 1.8 0 0 0 1.6-2.7l-1.2-2.1M14 16l-3 3 3 3M8.3 13.6 7 9.8l-3.8 1.4M9.3 5.2l1.2-2.1a1.8 1.8 0 0 1 3.1 0l4 6.9M13.4 8.2l3.8 1.4 1.4-3.9"/>',
};
export type IconName = keyof typeof paths;
interface Props {
  name: IconName;
  class?: string;
  label?: string;
}
const { name, class: className = 'h-5 w-5', label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
