---
/**
 * FAQ using native <details>/<summary> – works without JavaScript and with
 * screen readers. Layout pattern: Origin (heading left, accordion right).
 */
import Icon from './Icon.astro';
import Text from './Text.astro';

interface Props {
  items: { q: string; a: string }[];
  title: string;
  lead?: string;
  id?: string;
}
const { items, title, lead, id = 'faq' } = Astro.props;
---

<div class="grid gap-10 lg:grid-cols-12">
  <div class="lg:col-span-4">
    <h2 id={id} class="text-[1.625rem]">{title}</h2>
    {lead && <p class="mt-3">{lead}</p>}
  </div>
  <div class="divide-y divide-line bg-surface px-6 lg:col-span-8">
    {
      items.map((item, i) => (
        <details class="group" open={i === 0}>
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 text-lg leading-[1.2] font-bold text-accent-strong marker:hidden hover:underline [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="grid h-8 w-8 shrink-0 place-items-center text-accent-strong transition-transform duration-200 ease-out group-open:rotate-45" aria-hidden="true">
              <Icon name="plus" class="h-5 w-5" />
            </span>
          </summary>
          <div class="max-w-3xl pb-5">
            <p>
              <Text text={item.a} />
            </p>
          </div>
        </details>
      ))
    }
  </div>
</div>
