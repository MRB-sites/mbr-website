---
/**
 * Category pills with counts (pattern: Unseen Studio) + year dropdown (pattern: Canva).
 * Hidden without JS so the full list is always usable. Filters cards with
 * [data-project-card] inside [data-project-grid]; state is mirrored to the URL.
 */
import { fmt } from '../i18n';

interface Props {
  categories: { value: string; label: string; count: number }[];
  years: number[];
  total: number;
  labels: { label: string; category: string; year: string; all: string; allYears: string; showing: string; empty: string; reset: string };
}
const { categories, years, total, labels } = Astro.props;
const pill =
  'inline-flex min-h-10 items-center gap-1 rounded-full border-2 border-line-strong bg-surface px-4 font-semibold transition-colors duration-200 ease-out hover:border-ink aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-on-accent disabled:cursor-not-allowed disabled:opacity-40 [&>sup]:text-[0.7rem]';
---

<div data-project-filter hidden class="mb-10 flex flex-col gap-5 border-y border-line py-5 lg:flex-row lg:items-center lg:justify-between" data-showing={labels.showing}>
  <div role="group" aria-label={labels.category} class="flex flex-wrap gap-2">
    <button type="button" data-filter-category="" aria-pressed="true" class={pill}>
      {labels.all} <sup>{total}</sup>
    </button>
    {
      categories.map((c) => (
        <button type="button" data-filter-category={c.value} aria-pressed="false" class={pill} disabled={c.count === 0}>
          {c.label} <sup>{c.count}</sup>
        </button>
      ))
    }
  </div>
  <div class="flex items-center gap-3">
    <label for="filter-year" class="text-lg font-bold">{labels.year}</label>
    <select id="filter-year" data-filter-year class="min-h-11 border border-line-strong bg-surface px-3 pr-8">
      <option value="">{labels.allYears}</option>
      {years.map((y) => <option value={y}>{y}</option>)}
    </select>
  </div>
</div>
<p data-filter-status role="status" aria-live="polite" class="mb-6 text-sm text-ink-muted">{fmt(labels.showing, { count: total, total })}</p>
<div data-filter-empty hidden class="mb-10 border border-dashed border-line p-10 text-center">
  <p>{labels.empty}</p>
  <button type="button" data-filter-reset class="link-underline mt-3 font-semibold">{labels.reset}</button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-project-filter]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  if (root && grid) {
    root.hidden = false;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-project-card]')];
    const pills = [...root.querySelectorAll<HTMLButtonElement>('[data-filter-category]')];
    const year = root.querySelector<HTMLSelectElement>('[data-filter-year]')!;
    const status = document.querySelector<HTMLElement>('[data-filter-status]')!;
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]')!;
    const template = root.dataset.showing ?? '{count}/{total}';
    const params = new URLSearchParams(location.search);
    let category = params.get('kategori') ?? '';
    year.value = params.get('ar') ?? '';

    const apply = (updateUrl = true) => {
      let visible = 0;
      for (const card of cards) {
        const show = (!category || card.dataset.category === category) && (!year.value || card.dataset.year === year.value);
        card.hidden = !show;
        if (show) visible++;
      }
      pills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.filterCategory === category)));
      status.textContent = template.replace('{count}', String(visible)).replace('{total}', String(cards.length));
      empty.hidden = visible > 0;
      if (updateUrl) {
        const next = new URLSearchParams();
        if (category) next.set('kategori', category);
        if (year.value) next.set('ar', year.value);
        const qs = next.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }
    };

    pills.forEach((p) =>
      p.addEventListener('click', () => {
        category = p.dataset.filterCategory ?? '';
        apply();
      }),
    );
    year.addEventListener('change', () => apply());
    empty.querySelector('[data-filter-reset]')?.addEventListener('click', () => {
      category = '';
      year.value = '';
      apply();
    });
    apply(false);
  }
</script>
