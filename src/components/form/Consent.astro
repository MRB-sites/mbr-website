---
interface Props {
  id: string;
  name?: string;
  text: string;
  linkText: string;
  href: string;
}
const { id, name = 'samtycke', text, linkText, href } = Astro.props;
---

<div class="field" data-field>
  <label for={id} class="flex cursor-pointer items-start gap-3">
    <input id={id} type="checkbox" name={name} value="ja" required aria-describedby={`${id}-error`} class="mt-1 h-5 w-5 shrink-0 accent-[var(--accent)]" />
    <span>
      {text} <a href={href} class="link-underline font-semibold" target="_blank" rel="noopener">{linkText}</a>.
    </span>
  </label>
  <p id={`${id}-error`} class="mt-2 text-sm font-semibold text-danger" data-error hidden></p>
</div>
