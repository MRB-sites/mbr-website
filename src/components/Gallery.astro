---
/** Image grid; each image links to a full-size WebP (no lightbox JS needed). */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { fmt } from '../i18n';
import Photo from './Photo.astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
  openLabel: string;
}
const { images, alt, openLabel } = Astro.props;
const full = await Promise.all(images.map((src) => getImage({ src, width: Math.min(src.width, 2000), format: 'webp' })));
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    images.map((img, i) => (
      <li class:list={[i === 0 && images.length > 2 && 'sm:col-span-2 lg:col-span-2 lg:row-span-2']}>
        <a href={full[i].src} class="group block h-full" aria-label={fmt(openLabel, { n: i + 1 })}>
          <Photo
            src={img}
            alt={`${alt} ${i + 1}`}
            width={i === 0 ? 1200 : 800}
            height={i === 0 ? 900 : 600}
            sizes={i === 0 ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
            figureClass="aspect-[4/3] h-full transition-opacity group-hover:opacity-90"
          />
        </a>
      </li>
    ))
  }
</ul>
