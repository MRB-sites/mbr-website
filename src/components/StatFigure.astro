---
/** Key figure (patterns: monday.com left-rule stats, Revolut dark number band). */
import Text from './Text.astro';

interface Props {
  value: string;
  unit?: string;
  label: string;
}
const { value, unit, label } = Astro.props;
---

<div class="flex flex-col gap-1 border-t-[3px] border-accent-strong pt-3">
  <dt class="text-sm text-ink-muted">{label}</dt>
  <dd class="order-first text-[2rem] leading-[1.2] font-bold">
    <Text text={value} />{unit && <span class="ml-1 text-[1.375rem] font-bold">{unit}</span>}
  </dd>
</div>
