---
/** Sticky bottom bar on small screens (pattern: Swiggy / talabat dual CTA). */
import { DIRECT_CONTACT, HAS_PHONE } from '../config/company';
import AdviceButton from './AdviceButton.astro';
import { useT } from '../i18n';
import { quotePath, type Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<nav
  data-chrome="bottom"
  aria-label={t.a11y.mobileActions}
  class="fixed inset-x-0 bottom-0 z-30 grid gap-2 bg-surface px-4 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] shadow-[var(--shadow-header)] md:hidden"
>
  {
    HAS_PHONE ? (
      <a href={DIRECT_CONTACT.href} class="flex min-h-11 items-center justify-center rounded-full border-2 border-line-strong font-bold text-ink">
        {t.cta.call}
      </a>
    ) : (
      <AdviceButton locale={locale} fill />
    )
  }
  <a href={quotePath(locale)} data-bar-quote class="flex min-h-11 items-center justify-center rounded-full bg-accent font-bold text-on-accent">
    {t.cta.quote}
  </a>
</nav>

<style>
  /* While the advice field is open the quote button slides away so the email field gets the whole bar. */
  nav {
    grid-template-columns: 1fr 1fr;
    transition:
      grid-template-columns 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      column-gap 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  nav > * {
    min-width: 0;
  }
  [data-bar-quote] {
    overflow: hidden;
    white-space: nowrap;
    transition: opacity 0.25s ease;
  }
  nav:has([data-advice-root]:not([data-state='closed'])) {
    grid-template-columns: 1fr 0fr;
    column-gap: 0;
  }
  nav:has([data-advice-root]:not([data-state='closed'])) [data-bar-quote] {
    opacity: 0;
    pointer-events: none;
    border-width: 0;
  }
</style>
