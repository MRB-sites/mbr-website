---
/**
 * Before/after comparison. A native range input drives the split, so it works
 * with keyboard (arrow keys), touch and screen readers. Without JS it shows a 50/50 split.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  labels: { before: string; after: string; label: string };
}
const { before, after, beforeAlt, afterAlt, labels } = Astro.props;
const common = { width: 1600, height: 1000, layout: 'constrained' as const, fit: 'cover' as const, formats: ['avif', 'webp'] as ('avif' | 'webp')[], sizes: '(min-width: 1024px) 66vw, 100vw' };
---

<figure class="ba-slider" data-ba-slider style="--pos: 50%">
  <div class="relative aspect-[16/10] overflow-hidden bg-concrete-strong select-none">
    <Picture src={after} alt={afterAlt} {...common} class="absolute inset-0 h-full w-full object-cover" pictureAttributes={{ class: 'contents' }} />
    <div class="ba-before absolute inset-0">
      <Picture src={before} alt={beforeAlt} {...common} class="absolute inset-0 h-full w-full object-cover" pictureAttributes={{ class: 'contents' }} />
    </div>
    <span class="absolute top-4 left-4 bg-surface px-2 py-0.5 text-sm font-bold" aria-hidden="true">{labels.before}</span>
    <span class="absolute top-4 right-4 bg-accent px-2 py-0.5 text-sm font-bold text-on-accent" aria-hidden="true">{labels.after}</span>
    <div class="ba-handle pointer-events-none absolute inset-y-0 w-1 -translate-x-1/2 bg-accent" aria-hidden="true">
      <span class="absolute top-1/2 left-1/2 flex h-10 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-accent text-on-accent">
        <Icon name="arrow-left" class="h-4 w-4" /><Icon name="arrow" class="h-4 w-4" />
      </span>
    </div>
    <input type="range" min="0" max="100" value="50" step="1" aria-label={labels.label} class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
  </div>
</figure>

<style>
  .ba-before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-handle {
    left: var(--pos);
  }
  .ba-range {
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
  }
  .ba-slider:has(.ba-range:focus-visible) .ba-handle span {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba-slider]').forEach((slider) => {
    const range = slider.querySelector<HTMLInputElement>('.ba-range');
    if (!range) return;
    const update = () => {
      slider.style.setProperty('--pos', `${range.value}%`);
      range.setAttribute('aria-valuetext', `${range.value}%`);
    };
    range.addEventListener('input', update);
    update();
  });
</script>
