---
/** Pill button – the only rounded element on the site. Icons are accepted for API compatibility but not drawn. */
import type { IconName } from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline-light' | 'dark';
  size?: 'md' | 'lg';
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  class?: string;
  type?: 'button' | 'submit';
  /** Render as a plain span, e.g. a pill inside a link that is already clickable as a whole. */
  as?: 'span';
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', icon: _icon, iconPosition: _iconPosition, class: className, type = 'button', as, ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center rounded-full border-2 font-bold leading-none transition-[background-color,color,border-color] duration-200 ease-out select-none disabled:cursor-not-allowed disabled:opacity-60';
const sizes = { md: 'min-h-[2.6875rem] px-6 py-3 text-base', lg: 'min-h-12 px-7 py-3.5 text-[1.0625rem]' };
const variants = {
  primary: 'border-accent bg-accent text-on-accent hover:border-accent-strong hover:bg-accent-strong',
  secondary: 'border-line-strong bg-surface text-ink hover:border-ink',
  'outline-light': 'border-white text-white hover:bg-white hover:text-ink',
  dark: 'border-inverse bg-inverse text-on-inverse hover:opacity-90',
};
const Tag = as ?? (href ? 'a' : 'button');
---

<Tag href={href} type={Tag === 'button' ? type : undefined} class:list={[base, sizes[size], variants[variant], className]} {...rest}>
  <slot />
</Tag>
