# Copy to .env (local) or set in Netlify/Vercel environment settings.

# Full public URL, no trailing slash. Used for canonical URLs, hreflang, sitemap and Open Graph.
PUBLIC_SITE_URL=https://www.example.se

# Form handling: "netlify" (Netlify Forms, default) or "formspree" / "custom" (POST to PUBLIC_FORM_ENDPOINT).
PUBLIC_FORM_PROVIDER=netlify
# Required when provider is formspree/custom, e.g. https://formspree.io/f/xxxxxxx
PUBLIC_FORM_ENDPOINT=

# Analytics. Leave empty = no analytics, no cookies, no banner.
# "plausible" = loads Plausible only after the visitor accepts in the consent banner.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js

# Pexels API key – only used by `npm run photos` (scripts/fetch-pexels.mjs). Never exposed to the browser.
PEXELS_API_KEY=
